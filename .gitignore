# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/

# Editor / OS
.DS_Store
Thumbs.db
desktop.ini
.claude/
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# Logs
*.log

# Local tests (not committed)
.local_tests/

# PCAP data and extracted artifacts
*.pcap
*.pcapng
*.cap
*.pcap.gz
*.pcapng.gz
*.pcap.zst
*.pcapng.zst
files/

# ...except the synthetic test fixtures, which are committed so the suite runs
# with nothing but pytest. They are generated by tests/make_fixtures.py and
# contain no real traffic. Keep this rule below the *.pcap exclusion above.
!tests/data/*.pcap
!tests/data/*.pcapng

# pcapper run outputs / carved & decrypted artifacts / case & evidence exports
carved/
decrypted/
case-*/
*.sqlite
*.sqlite3
*.db
pcapper.toml
# --voip-out decodes G.711 RTP to WAV; recovered call audio is evidence.
*.wav
# --csv export. No CSV is committed, so a blanket rule is safe here; JSON is
# deliberately NOT blanket-ignored because the package ships *_mappings.json
# and *_opcodes.json data files (see [tool.setuptools.package-data]).
*.csv

# Key material and secrets. --tls-keylog / --ssh-keylog take NSS key logs, and
# decryption workflows tend to leave keys next to the capture being worked on.
# Add a fixture with `git add -f` if the suite ever needs a committed cert.
.env
.env.*
*.keylog
*keylog*.txt
sslkeys*.txt
*.pem
*.key

# GeoIP databases (PCAPPER_GEOIP_CITY_DB / PCAPPER_GEOIP_ASN_DB) — large,
# licensed, and redistributed by MaxMind, never by this repo.
*.mmdb

# Jupyter
.ipynb_checkpoints/
